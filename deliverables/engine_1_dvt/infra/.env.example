# ==============================================================================
# Engine 1 Node Operator Environment Variables
# Stack: Obol Charon DVT (3-of-4) + Lighthouse + Nethermind + MEV-Boost
# Integration: Lido Community Staking Module (CSM V3) + 0xSplits v2
# ==============================================================================

# Target Ethereum Network: 'mainnet' or 'holesky'
NETWORK=mainnet

# Checkpoint Sync URL for rapid Consensus Layer synchronization
# Mainnet: https://mainnet.checkpoint.sigp.io or https://sync-mainnet.beaconcha.in
# Holesky: https://holesky.checkpoint.sigp.io
CHECKPOINT_SYNC_URL=https://mainnet.checkpoint.sigp.io

# ------------------------------------------------------------------------------
# 0xSplits v2 Fee Recipient & MEV Configuration
# ------------------------------------------------------------------------------
# In a 4-operator DVT cluster, set this to your deployed immutable 4-way 0xSplits contract
# address (see deliverables/engine_1_dvt/splits/REVENUE_SPLITS_CONTRACT.md).
# Fallback / Default Lido Execution Layer Rewards Vault:
#   Mainnet Lido Default: 0x388C818CA8B9251b393131C08a736829d0f89252
#   Holesky Lido Default: 0xE73a4D20f794051a8d793617307686E7a80b0F1E
FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# MEV-Boost Relay Endpoints (Lido DAO Approved Relays)
# ------------------------------------------------------------------------------
# Comma-separated list of approved builder relay endpoints
MEV_RELAYS=https://0xac6e77dfe25ecd6110b8e780608cce0dab71fdd5ebea22a16c0205200f2f8424e0004fcedfe20fe6d412d3257371c26e@builder-relay.flashbots.net,https://0xa1559ace749688b30f0e49e130e1528612e3a04643a508b90224130f01a454c60651307141b073b80b0422a433080e70@relay.ultrasound.money,https://0xa7ab67ea25d143680e14cb7b0154784111295a05401583ab89f63925844048b88170829164866b399d713c57b60fd9d3@agnostic-relay.net

# ------------------------------------------------------------------------------
# P2P Network Configuration
# ------------------------------------------------------------------------------
# Node Operator Public IP or FQDN for Charon P2P connectivity
OPERATOR_PUBLIC_IP=123.45.67.89
